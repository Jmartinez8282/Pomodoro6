# Public values only. Everything prefixed NEXT_PUBLIC_ is inlined into the
# client bundle at build time and is world-readable — never put a credential
# here, in Vercel's env vars, or anywhere else with that prefix.

# GA4 measurement ID. Public by design; safe to expose.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical origin, used for metadata, sitemap, and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
